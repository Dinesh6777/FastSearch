#include "resource.h"
#include <windows.h>

// Icons
IDR_MAINFRAME ICON    "FastSearch.ico"
IDI_TRAY     ICON    "FastSearch.ico"

// Main Accelerator Table for standard shortcuts
IDR_MAINFRAME ACCELERATORS
BEGIN
    "T",            ID_FILE_NEW_TAB,        VIRTKEY, CONTROL
    "W",            ID_FILE_CLOSE_TAB,      VIRTKEY, CONTROL
    "S",            ID_FILE_EXPORT,         VIRTKEY, CONTROL
END

// Main Window Menu
IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New Tab\tCtrl+T",             ID_FILE_NEW_TAB
        MENUITEM "&Close Tab\tCtrl+W",           ID_FILE_CLOSE_TAB
        MENUITEM "&Export list...\tCtrl+S",      ID_FILE_EXPORT
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Details",                    ID_VIEW_DETAILS
        MENUITEM "&Small Icons",                ID_VIEW_SMALL_ICONS
        MENUITEM "&Medium Icons",               ID_VIEW_MEDIUM_ICONS
        MENUITEM "&Large Icons",                ID_VIEW_LARGE_ICONS
        MENUITEM "&Extra Large Icons",          ID_VIEW_EXTRA_LARGE_ICONS
    END
    POPUP "&Options"
    BEGIN
        MENUITEM "&Columns settings...",        ID_VIEW_SETTINGS
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About FastSearch",           ID_HELP_ABOUT
    END
END

// System Tray Context Menu
IDR_TRAYMENU MENU
BEGIN
    POPUP "Tray"
    BEGIN
        MENUITEM "&Restore FastSearch",          ID_TRAY_RESTORE
        MENUITEM "&New Search Window",           ID_TRAY_NEW_WINDOW
        MENUITEM SEPARATOR
        MENUITEM "E&xit FastSearch",             ID_TRAY_EXIT
    END
END

// Column Visibility Settings Dialog Template
IDD_SETTINGS DIALOGEX 0, 0, 240, 175
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Columns Settings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Search Results Visible Columns", -1, 10, 10, 220, 130
    
    // Checkboxes (Name and Path are mandatory and grayed out)
    CONTROL         "File/Folder Name", IDC_CHECK_NAME, "Button", BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP, 20, 25, 90, 10
    CONTROL         "File Path", IDC_CHECK_PATH, "Button", BS_AUTOCHECKBOX | WS_DISABLED | WS_TABSTOP, 20, 40, 90, 10
    
    CONTROL         "Logical Size", IDC_CHECK_SIZE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 55, 90, 10
    CONTROL         "Size on Disk", IDC_CHECK_SIZE_DISK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 20, 70, 90, 10
    
    CONTROL         "Date Modified", IDC_CHECK_MODIFIED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 25, 90, 10
    CONTROL         "Date Created", IDC_CHECK_CREATED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 40, 90, 10
    CONTROL         "Date Accessed", IDC_CHECK_ACCESSED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 55, 90, 10
    CONTROL         "Attributes", IDC_CHECK_ATTRIBUTES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 120, 70, 90, 10
    
    DEFPUSHBUTTON   "OK", IDOK, 120, 150, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 175, 150, 50, 14
END

// Generic Input Dialog Template
IDD_INPUT DIALOGEX 0, 0, 220, 80
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Input"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Label text:", IDC_INPUT_LABEL, 10, 10, 200, 10
    EDITTEXT        IDC_INPUT_EDIT, 10, 25, 200, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 105, 55, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 160, 55, 50, 14
END
